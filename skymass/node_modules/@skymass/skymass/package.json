{
  "name": "@skymass/skymass",
  "version": "0.3.81",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/skymasshq/skymass-ui.git"
  },
  "license": "MIT",
  "files": [
    "README.md",
    "LICENSE.txt",
    "dist/"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "rm -rf dist && npx tsc && cp dist/index.d.mts dist/index.d.ts",
    "watch": "npx tsc --watch",
    "lint": "eslint --ext .ts,.mts src",
    "typecheck": "npx tsc --noEmit",
    "typecheck:watch": "npx tsc --watch --noEmit",
    "test:watch": "tsx watch --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^18.19.68",
    "@types/ws": "^8.2.2",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard-with-typescript": "^39.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-n": "^16.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^3.0.3",
    "tsx": "^4.6.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@grinstead/atomize": "^0.1.13",
    "rxjs": "^7.5.6",
    "ws": "^8.4.2",
    "zod": "^3.22.4"
  },
  "description": "SkyMass UI-as-a-Service client",
  "bugs": {
    "url": "https://github.com/skymasshq/skymass-ui/issues"
  },
  "homepage": "https://skymass.dev"
}
