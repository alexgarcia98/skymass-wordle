import { Observable, OperatorFunction } from "rxjs";
import { ProcessingValue } from "../AppData.mjs";
/**
 * Runs the given function on the inputs.
 *
 * If data comes in while the mapper is running, then we wait to call the mapper
 * again until after it's previous run finishes. At that point, we call it with
 * the newest input value. If input values are promises, then the newest input
 * value will be awaited on and then the mapper will run (if an additional input
 * comes in while we are awaiting on the old one, then we await and run on the
 * new instead).
 *
 * The effect is that mapper will never be called while its past run is still
 * happening.
 *
 * Even if handed non-promise inputs, this will wait for a promise tick
 *
 * @param mapper The code to run
 * @param dropOutdatedResults If this is true and a new input comes in while
 * mapper is running, than we drop the output of the current run.
 * @returns An Rx Operator
 */
export declare function mapMostRecent<In, Out, EmitProcessing extends boolean = false>(mapper: (arg: In) => Promise<Out> | Out, dropOutdatedResults?: boolean, dropAbandonedData?: boolean, emitProcessing?: EmitProcessing): OperatorFunction<Promise<In> | In, EmitProcessing extends true ? Out | ProcessingValue : Out>;
/**
 * This is conceptually the same as {@link mapMostRecent}, however, it will
 * output a promise rather than the resolved value.
 *
 * The outputted promise will be sent _synchronously_ when a new input is
 * received (unless that input does not trigger an additional run, which is when
 * multiple inputs come in during a run.)
 *
 * @param mapper The code to run
 * @param dropOutdatedResults If this is true and a new input comes in while
 * mapper is running, than we hijack the already outputted promise to return the
 * newer result
 * @returns An Rx Operator
 */
export declare function mapMostRecentToPromise<In, Out>(mapper: (arg: In) => Promise<Out> | Out, dropOutdatedResults?: boolean): OperatorFunction<Promise<In> | In, Promise<Out>>;
