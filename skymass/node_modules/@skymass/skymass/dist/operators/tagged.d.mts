 * This function provides code for making an observable of a map of observables.
 *
 * todo: more explanation
 */
export declare function tagged<Key, In, Out>(op: OperatorFunction<In, Out>): OperatorFunction<TaggedNotification<Key, In>, TaggedNotification<Key, Out>>;
